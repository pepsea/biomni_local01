# ---- LLM プロバイダ -----------------------------------------------------------
# ollama   : ローカル完結。質問文もデータも外部に出ない
# anthropic: Claude API。1M context だが、質問文と実行結果が Anthropic に送信される
HYPO_PROVIDER=ollama

# Claude API を使う場合に設定する（未設定ならモデル一覧に出るが選べない）
# ANTHROPIC_API_KEY=sk-ant-...
# HYPO_ANTHROPIC_MAX_TOKENS=8192

# ---- LLM (Ollama) -----------------------------------------------------------
# ローカルにあるモデルは `python scripts/list_models.py` で一覧できる。
# 既定を変えるなら `python scripts/list_models.py --set <モデル名>`
# （HYPO_MODEL と BIOMNI_LLM の両方を書き換える必要があるため）
HYPO_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434
HYPO_TEMPERATURE=0.7
HYPO_EXTRACTOR_TEMPERATURE=0.2
# 仮説抽出だけ別モデルにする場合（空なら HYPO_MODEL と同じ）
HYPO_EXTRACTOR_MODEL=
# Ollama の既定 num_ctx は 2048。A1 のシステムプロンプトだけで超えるので必ず上げる。
# モデルの上限を超える値を書いても、選択時に自動で丸められる
HYPO_NUM_CTX=32768
HYPO_NUM_PREDICT=4096

# ---- ラン制御 ---------------------------------------------------------------
HYPO_MAX_STEPS=60
HYPO_WALLCLOCK_LIMIT_SEC=1800
HYPO_MAX_HYPOTHESES=5
# エージェントへの指示文の言語（en 推奨。ユーザーの記述は翻訳せずそのまま埋め込む）
HYPO_PROMPT_LANGUAGE=en
BIOMNI_TIMEOUT_SECONDS=600
# v1 の既定は false。true にするなら num_ctx を 32k 以上にすること（§4.5）
HYPO_USE_TOOL_RETRIEVER=false
# true にすると外部 DB / 文献 API を使わない。質問文が一切外部に出ない
HYPO_OFFLINE_MODE=false

# ---- Docker で常設する場合 ----------------------------------------------------
# ホスト側の待ち受けポート（コンテナ内は 8000 固定）
APP_PORT=8000
# 待ち受けるインタフェース。外部に出したくないなら 127.0.0.1
APP_BIND=0.0.0.0
# Ollama をホストから使いたい場合のポート（既定はループバックのみ）
OLLAMA_PORT=11434
OLLAMA_BIND=127.0.0.1
# コンテナをホストと同じ UID/GID で動かす（bind マウントの権限対策）。
# scripts/install-service.sh が自動で書き込む
# APP_UID=1000
# APP_GID=1000

# ---- パス -------------------------------------------------------------------
BIOMNI_PATH=./data
HYPO_WORKSPACE=./workspace
HYPO_POLICY_PATH=./config/resource_policy.yaml

# ---- biomni の default_config を Ollama に向ける ------------------------------
# biomni/tool/database.py は A1 のコンストラクタ引数ではなく default_config を見るため、
# これらが無いと DB クエリツールが Anthropic API を呼びに行く（docs/design/04 §4.3）。
# 通常は apply_biomni_env() が実行時に設定するが、明示しておくと事故が減る。
BIOMNI_LLM=qwen3:14b
BIOMNI_SOURCE=Ollama
LLM_SOURCE=Ollama
BIOMNI_COMMERCIAL_MODE=true

# API キーは設定しないこと。設定するとローカル完結の前提が崩れる
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
