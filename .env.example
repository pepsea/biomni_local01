# ---- LLM プロバイダ -----------------------------------------------------------
# ここで決めるのは「既定のプロバイダ」だけ。実行ごとの切り替えは画面のモデル選択
# （およびノートブックの apply_model_selection）で行う。選んだモデル名から
# プロバイダが決まり、そのランの環境変数が組み立てられる。
#
# ollama   : ローカル完結。質問文もデータも外部に出ない
# anthropic: Claude API。1M context だが、質問文と実行結果が Anthropic に送信される
#
# 両方を選べるようにするには（ANTHROPIC_API_KEY を設定したうえで）:
#   bash scripts/set-provider.sh both --key sk-ant-...
HYPO_PROVIDER=ollama

# 使いません（互換のために残しています）。Ollama はホストで動いているものだけを
# 使う構成なので、compose に ollama サービスはありません（docs/design/21 §21.15）
COMPOSE_PROFILES=

# biomni の default_config が向く先。HYPO_PROVIDER に合わせること（docs/design/04 §4.3）
#   ollama    -> Ollama
#   anthropic -> Anthropic
BIOMNI_SOURCE=Ollama

# Claude API を使う場合に設定する（未設定ならモデル一覧に出るが選べない）。
# HYPO_PROVIDER=ollama のままでもよい。キーがあれば一覧に Claude が並び、
# 実行ごとに選べるようになる。Ollama を選んだランでは BIOMNI_SOURCE=Ollama が
# 立つので、biomni 内部の LLM 呼び出しも Anthropic へは行かない。
# ANTHROPIC_API_KEY=sk-ant-...
# HYPO_ANTHROPIC_MAX_TOKENS=8192

# ---- LLM (Ollama) -----------------------------------------------------------
# ローカルにあるモデルは `python scripts/list_models.py` で一覧できる。
# 既定を変えるなら `python scripts/list_models.py --set <モデル名>`
# （HYPO_MODEL と BIOMNI_LLM の両方を書き換える必要があるため）
HYPO_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434
HYPO_TEMPERATURE=0.7
HYPO_EXTRACTOR_TEMPERATURE=0.2
# 仮説抽出だけ別モデルにする場合（空なら HYPO_MODEL と同じ）
HYPO_EXTRACTOR_MODEL=
# biomni の DB ツール（query_uniprot / query_opentarget など）が
# 「自然文 → API の URL」を作るときだけ使うモデル。空ならエージェントと同じ。
#
# ここはスキーマ厳守が要る。小さいローカルモデルはフィールド名を作ってしまい、
# API に 400 で弾かれる（docs/design/24）。エージェント本体はローカルのまま、
# この 1 か所だけ Claude に寄せられる。
# 注意: 質問由来の語（遺伝子名など）が Anthropic に送信されます。
#       HYPO_OFFLINE_MODE=true のときは設定しても無視されます。
# HYPO_TOOL_QUERY_MODEL=claude-sonnet-5
# Ollama の既定 num_ctx は 2048。A1 のシステムプロンプトだけで超えるので必ず上げる。
# モデルの上限を超える値を書いても、選択時に自動で丸められる
HYPO_NUM_CTX=32768
HYPO_NUM_PREDICT=4096

# ---- ラン制御 ---------------------------------------------------------------
HYPO_MAX_STEPS=60
HYPO_WALLCLOCK_LIMIT_SEC=1800
HYPO_MAX_HYPOTHESES=5
# エージェントへの指示文の言語（en 推奨。ユーザーの記述は翻訳せずそのまま埋め込む）
HYPO_PROMPT_LANGUAGE=en
BIOMNI_TIMEOUT_SECONDS=600
# v1 の既定は false。true にするなら num_ctx を 32k 以上にすること（§4.5）
HYPO_USE_TOOL_RETRIEVER=false
# true にすると外部 DB / 文献 API を使わない。質問文が一切外部に出ない
HYPO_OFFLINE_MODE=false

# ---- Docker で常設する場合 ----------------------------------------------------
# ホスト側の待ち受けポート（コンテナ内は 8000 固定）
APP_PORT=8000
# 待ち受けるインタフェース。外部に出したくないなら 127.0.0.1
APP_BIND=0.0.0.0
# ホストの Ollama が待ち受けているポート。
# bash scripts/set-provider.sh ollama が、実際に動いているものを探して合わせます
OLLAMA_PORT=11434
# コンテナをホストと同じ UID/GID で動かす（bind マウントの権限対策）。
# scripts/install-service.sh が自動で書き込む
# APP_UID=1000
# APP_GID=1000

# ---- パス -------------------------------------------------------------------
BIOMNI_PATH=./data
HYPO_WORKSPACE=./workspace
HYPO_POLICY_PATH=./config/resource_policy.yaml

# ---- biomni の default_config を Ollama に向ける ------------------------------
# biomni/tool/database.py は A1 のコンストラクタ引数ではなく default_config を見るため、
# これらが無いと DB クエリツールが Anthropic API を呼びに行く（docs/design/04 §4.3）。
# 通常は apply_biomni_env() が実行時に設定するが、明示しておくと事故が減る。
BIOMNI_LLM=qwen3:14b
BIOMNI_SOURCE=Ollama
LLM_SOURCE=Ollama
BIOMNI_COMMERCIAL_MODE=true

# ローカル完結（質問文を一切外部に出さない）を厳密に守りたい場合は、
# API キーを設定せず HYPO_OFFLINE_MODE=true にすること。
# キーを設定すると Claude が選択肢に現れる（選ばなければ送信はされない）。
# OPENAI_API_KEY=
